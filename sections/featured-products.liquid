<section class="bg-sand py-12 md:py-16">
  <div class="max-w-screen-xl mx-auto px-4">

    <h2 class="font-display text-3xl md:text-4xl text-deep text-center mb-8 md:mb-12">
      {{ section.settings.heading }}
    </h2>

    {%- comment -%}
      Falls back to a collection handle when nothing is picked in the theme
      editor. A preset cannot reference a collection that does not exist yet, so
      without this the home page ships telling shoppers to configure a theme.
    {%- endcomment -%}
    {%- assign source = section.settings.collection -%}
    {%- if source == blank -%}
      {%- assign source = collections[section.settings.fallback_handle] -%}
    {%- endif -%}

    {%- if source != blank and source.all_products_count > 0 -%}
      {%- assign featured_products = source.products | limit: section.settings.product_count -%}

      {%- comment -%}
        Home page rows scroll sideways instead of stacking, so the page stays
        short and a shopper can browse a whole collection without a click. The
        slide widths sit just under 1/n of the rail so the next card is always
        part-visible — that clipped edge is the only affordance telling anyone
        the row moves.
      {%- endcomment -%}
      {%- capture rail_items -%}
        {%- for product in featured_products -%}
          <div class="snap-start shrink-0 w-[42%] sm:w-[30%] md:w-[22%]">
            {%- render 'product-card', product: product -%}
          </div>
        {%- endfor -%}
      {%- endcapture -%}
      {%- render 'carousel', items: rail_items, label: section.settings.heading -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "fallback_handle",
      "label": "Fallback collection handle",
      "info": "Used only when no collection is picked above.",
      "default": "best-sellers"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Number of products",
      "info": "This row scrolls sideways, so it holds far more than a grid row would.",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 12
    }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
