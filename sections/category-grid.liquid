{%- comment -%}
  Category Grid

  Blocks let the owner curate the home page from the theme editor. When no block
  has a collection assigned — which is how the section ships, since a preset
  cannot reference a collection that does not exist yet — it falls back to the
  store's real collections by handle so the home page is never a wall of empty
  grey tiles pointing at "#".

  Collections with no products are skipped rather than rendered as dead ends.
{%- endcomment -%}

{%- assign fallback_handles = section.settings.fallback_handles
  | default: 'lingerie,swimwear,leather-vinyl,hosiery,plus-size,menswear,costumes,new-in'
  | split: ',' -%}

{%- assign configured = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.collection != blank -%}
    {%- assign configured = configured | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section class="bg-cream py-12 md:py-16">
  <div class="max-w-screen-xl mx-auto px-4">
    {%- if section.settings.heading != blank -%}
      <h2 class="font-display text-3xl md:text-4xl font-normal text-deep mb-6 md:mb-8">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- comment -%}
      Categories scroll sideways like the product rows below them, so the home
      page opens with browsable rows rather than a full screen of tiles. Slide
      widths sit just under 1/n of the rail so the next tile stays part-visible
      and the row reads as scrollable.
    {%- endcomment -%}
    {%- capture rail_items -%}
      {%- if configured > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- if col != blank and col.all_products_count > 0 -%}
            {%- assign card_label = block.settings.label | default: col.title -%}
            <div class="snap-start shrink-0 w-[42%] sm:w-[30%] md:w-[22%]">
              {%- render 'category-card', collection: col, label: card_label, attrs: block.shopify_attributes -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for handle in fallback_handles -%}
          {%- comment -%}
            The handle must be stripped into its own variable first: Liquid does
            not allow a filter inside a bracket lookup, and Shopify rejects the
            whole file if you try — silently keeping the previously synced copy.
          {%- endcomment -%}
          {%- assign clean_handle = handle | strip -%}
          {%- assign col = collections[clean_handle] -%}
          {%- if col != blank and col.all_products_count > 0 -%}
            <div class="snap-start shrink-0 w-[42%] sm:w-[30%] md:w-[22%]">
              {%- render 'category-card', collection: col, label: col.title, attrs: '' -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign rail_label = section.settings.heading | default: 'Categories' -%}
    {%- render 'carousel', items: rail_items, label: rail_label -%}
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "fallback_handles",
      "label": "Fallback collection handles",
      "info": "Comma-separated. Used only when no category cards below have a collection assigned. Collections with no products are skipped.",
      "default": "lingerie,swimwear,leather-vinyl,hosiery,plus-size,menswear,costumes,new-in"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Card label override",
          "info": "Leave blank to use collection title"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category Grid"
    }
  ]
}
{% endschema %}
