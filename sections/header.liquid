<header class="fixed top-0 left-0 right-0 z-50 bg-deep h-14 lg:h-16" role="banner">
  <div class="max-w-screen-xl mx-auto px-4 h-full flex items-center justify-between">

    <!-- Mobile: hamburger (left) -->
    <button
      id="nav-hamburger"
      class="lg:hidden flex items-center justify-center w-8 h-8 text-cream focus:outline-none focus-visible:ring-2 focus-visible:ring-coral"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="flex items-center absolute left-1/2 -translate-x-1/2 lg:static lg:translate-x-0 lg:left-auto">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          class="h-8 w-auto"
          loading="eager"
        >
      {%- else -%}
        <span class="font-display text-xl text-cream tracking-widest uppercase">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Desktop nav links + inline search -->
    <nav id="nav-links" class="hidden lg:flex items-center gap-8 transition-opacity duration-200" aria-label="Main navigation">
      {%- comment -%}
        Driven by collection handles rather than hardcoded labels and URLs. The
        previous list still pointed at /collections/bikinis, which only resolved
        via a redirect after the collection was renamed to swimwear, and included
        a Sale link that led to an empty collection. Empty collections are skipped
        so the nav can never advertise a dead end.
      {%- endcomment -%}
      {%- assign nav_handles = section.settings.nav_handles
        | default: 'new-in,lingerie,swimwear,leather-vinyl,plus-size,menswear,sale'
        | split: ',' -%}
      {%- for raw_handle in nav_handles -%}
        {%- assign nav_handle = raw_handle | strip -%}
        {%- assign nav_collection = collections[nav_handle] -%}
        {%- if nav_collection != blank and nav_collection.all_products_count > 0 -%}
          <a
            href="{{ nav_collection.url }}"
            class="font-body text-sm tracking-widest uppercase transition-colors duration-200 hover:text-gold
              {%- if nav_handle == 'sale' %} text-coral{%- else %} text-cream{%- endif %}
              {%- if request.path == nav_collection.url %} border-b-2 border-coral pb-0.5{%- endif %}"
          >{{ nav_collection.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <!-- Inline search bar (hidden by default, shown when search toggled) -->
    {%- comment -%}
      The toggle button next to it renders at every width, but this bar used
      to be `hidden lg:flex`, so below 1024px tapping search did nothing at all.
      It is now hidden by `hidden` alone (inline-search.js adds `flex` when it
      opens), and on small screens it spans the header row -- inset-y-0 plus
      left-4/right-4 with bg-deep -- so it covers the hamburger, the centred
      logo and the icon row rather than colliding with them. Absolute insets
      resolve against <header>, which is the nearest positioned ancestor, and an
      absolutely positioned box paints above the static icon row that follows it
      in the DOM. From lg up the insets are released and the original centred,
      fixed-width bar is restored.

      It is also a real GET form now. A phone keyboard's "Go"/"Search" key is not
      guaranteed to reach a bare keydown listener, and submitting is the only
      path that works with JS still loading -- so the native submit carries the
      query and inline-search.js no longer has to.
    {%- endcomment -%}
    <form
      id="nav-search-bar"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="hidden absolute inset-y-0 left-4 right-4 bg-deep lg:inset-y-auto lg:left-1/2 lg:right-auto lg:bg-transparent lg:-translate-x-1/2 items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-label="Site search"
    >
      <input
        id="nav-search-input"
        type="search"
        name="q"
        placeholder="Search…"
        enterkeyhint="search"
        class="bg-transparent border-b border-cream text-cream font-body text-sm tracking-wider placeholder:text-mid focus:outline-none flex-1 min-w-0 lg:flex-none lg:w-64 py-1"
        aria-label="Search products"
      >
      <button
        id="nav-search-close"
        type="button"
        class="flex-shrink-0 text-cream hover:text-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-coral"
        aria-label="Close search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </form>

    {%- comment -%}
      Right icons: search, cart. No account link.

      The store sells to guests. Shopify's new customer accounts intercept
      /account before the theme renders, and if accounts are switched off in
      Settings the URL dies outright — so an account icon here is either
      redundant or broken. Order tracking is already covered: every order
      confirmation email carries a status link that needs no login.
    {%- endcomment -%}
    <div class="flex items-center gap-3 ml-auto lg:ml-0">
      <!-- Search toggle -->
      <button
        id="nav-search-toggle"
        class="flex items-center justify-center w-8 h-8 text-cream hover:text-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-coral transition-colors duration-200"
        aria-label="Search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
        </svg>
      </button>

      <!-- Cart -->
      <button
        id="nav-cart-toggle"
        class="relative flex items-center justify-center w-8 h-8 text-cream hover:text-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-coral transition-colors duration-200"
        aria-label="Cart, {{ cart.item_count }} items"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" />
        </svg>
        {%- if cart.item_count > 0 -%}
          <span
            id="cart-count-badge"
            class="absolute -top-1 -right-1 flex items-center justify-center w-4 h-4 rounded-full bg-coral text-cream text-[10px] font-body leading-none"
            aria-hidden="true"
          >{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
    </div>

  </div>
</header>

<!-- Mobile nav drawer -->
<div
  id="mobile-nav-drawer"
  class="fixed inset-y-0 left-0 z-[60] w-[280px] bg-deep transform -translate-x-full transition-transform duration-300 ease-in-out"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="flex items-center justify-between px-6 py-4 border-b border-cream/10">
    <span class="font-display text-lg text-cream tracking-widest uppercase">Menu</span>
    <button
      id="mobile-nav-close"
      class="flex items-center justify-center w-8 h-8 text-cream hover:text-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-coral"
      aria-label="Close navigation menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col py-4" aria-label="Mobile navigation">
    {%- comment -%}
      Mirrors the desktop nav from the same handle list, so the two cannot drift.
    {%- endcomment -%}
    {%- for raw_handle in nav_handles -%}
      {%- assign nav_handle = raw_handle | strip -%}
      {%- assign nav_collection = collections[nav_handle] -%}
      {%- if nav_collection != blank and nav_collection.all_products_count > 0 -%}
        <a
          href="{{ nav_collection.url }}"
          class="font-display text-3xl py-4 px-8 hover:text-gold transition-colors duration-200
            {%- if nav_handle == 'sale' %} text-coral{%- else %} text-cream{%- endif %}"
        >{{ nav_collection.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
</div>

<!-- Mobile nav overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-50 bg-deep/50 backdrop-blur-sm hidden"
  aria-hidden="true"
></div>

<script type="module" src="{{ 'mobile-nav.js' | asset_url }}"></script>
<script type="module" src="{{ 'inline-search.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "nav_handles",
      "label": "Navigation collection handles",
      "info": "Comma-separated. Empty collections are skipped automatically.",
      "default": "new-in,lingerie,swimwear,leather-vinyl,plus-size,menswear,sale"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold ($)",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
