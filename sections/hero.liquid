{%- comment -%}
  Hero — split panel: editorial image left, copy right.

  The image is absolutely filled rather than sized with h-full. On desktop the left
  panel is `md:aspect-auto`, so it has no intrinsic height and takes it from the
  flex row; a percentage-height chain resolves against nothing and the photograph
  renders at its natural size. Same failure that left landscape product photos
  short in their cards.

  Falls back to a collection's first product image if no hero image is set, so the
  section never ships as an empty grey panel.
{%- endcomment -%}

{%- assign hero_image = section.settings.image -%}
{%- if hero_image == blank -%}
  {%- assign fallback = collections[section.settings.fallback_handle] -%}
  {%- assign hero_image = fallback.products.first.featured_image -%}
{%- endif -%}

<div class="flex flex-col md:flex-row min-h-[60vh] md:min-h-[80vh]">

  <!-- Left panel: image (55% desktop) -->
  <div class="relative w-full md:w-[55%] aspect-[4/3] md:aspect-auto bg-sand overflow-hidden">
    {%- if hero_image != blank -%}
      <img
        src="{{ hero_image | image_url: width: 1600 }}"
        alt="{{ section.settings.image_alt | default: shop.name | escape }}"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        width="1600"
      >
    {%- endif -%}
  </div>

  <!-- Right panel: copy (45% desktop) -->
  <div class="flex flex-col justify-center bg-deep px-8 py-16 md:px-12 md:py-20 lg:px-16 w-full md:w-[45%]">
    {%- if section.settings.eyebrow != blank -%}
      <p class="font-body text-xs font-semibold tracking-widest uppercase text-gold mb-4">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-normal leading-tight text-cream">
      {{ section.settings.heading | escape }}
    </h1>

    <p class="font-body text-lg md:text-xl font-normal tracking-wide text-cream/80 mt-4 max-w-md">
      {{ section.settings.subheading | escape }}
    </p>

    <div class="flex flex-col sm:flex-row gap-3 mt-8">
      <a
        href="{{ section.settings.cta_url | default: '/collections/new-in' }}"
        class="inline-block bg-coral text-cream font-body text-sm font-semibold tracking-widest uppercase px-8 py-3 text-center hover:bg-coral/90 transition-colors duration-200 focus:ring-2 focus:ring-coral focus:ring-offset-2 focus:outline-none"
      >
        {{ section.settings.cta_label | escape }}
      </a>
      {%- if section.settings.cta2_label != blank -%}
        <a
          href="{{ section.settings.cta2_url | default: '/collections/swimwear' }}"
          class="inline-block border border-cream/50 text-cream font-body text-sm font-semibold tracking-widest uppercase px-8 py-3 text-center hover:bg-cream hover:text-deep transition-colors duration-200 focus:ring-2 focus:ring-coral focus:ring-offset-2 focus:outline-none"
        >
          {{ section.settings.cta2_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Hero image alt text",
      "default": "Velvet Tide swimwear on the beach at golden hour"
    },
    {
      "type": "text",
      "id": "fallback_handle",
      "label": "Fallback collection handle",
      "info": "Used only when no hero image is chosen above. Takes that collection's first product image.",
      "default": "swimwear"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New drops every week"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Bare, on your terms."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheadline",
      "default": "Swim, lingerie and leather in sizes S to 4X. Shipped discreetly from the US."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop New In"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Shop Swimwear"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
