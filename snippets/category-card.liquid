{%- comment -%}
  Snippet: category-card
  Usage:
    {% render 'category-card', collection: col, label: 'Lingerie', attrs: '' %}

  Parameters:
    collection — Shopify collection object (required)
    label      — string shown over the image (required)
    attrs      — block.shopify_attributes, or '' when rendered outside a block

  These collections are built by the supplier import and have no featured image
  set, so the card falls back to the first product's photo. Without that fallback
  every tile is a grey box.
{%- endcomment -%}

{%- assign card_image = collection.featured_image -%}
{%- if card_image == blank -%}
  {%- assign card_image = collection.products.first.featured_image -%}
{%- endif -%}

<a
  href="{{ collection.url }}"
  aria-label="{{ label | escape }}"
  class="relative group block aspect-square overflow-hidden bg-sand"
  {{ attrs }}
>
  {%- if card_image != blank -%}
    <img
      src="{{ card_image | image_url: width: 500 }}"
      alt="{{ label | escape }}"
      width="500"
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    >
  {%- endif -%}

  <div class="absolute inset-0 bg-deep/40 group-hover:bg-deep/60 transition-colors duration-300 flex flex-col items-center justify-center text-center px-2">
    <span class="text-cream font-body text-xs sm:text-sm font-semibold tracking-widest uppercase">
      {{ label | escape }}
    </span>
    <span class="text-cream/70 font-body text-[0.65rem] tracking-wide mt-1">
      {{ collection.all_products_count }} {% if collection.all_products_count == 1 %}item{% else %}items{% endif %}
    </span>
  </div>
</a>
