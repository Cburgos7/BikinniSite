node_modules/
.DS_Store
*.log
__pycache__/
.env
.env.local
.env.*.local

# Supplier data — this repo is public, and the Elegant Moments wholesale licence
# forbids redistribution ("for your sole use... do not distribute or redistribute").
# The price lists are also our cost basis. Scripts are tracked; their inputs and
# outputs are not.
data/suppliers/*/source/
data/suppliers/*/out/

# Supplier downloads staging area — raw workbooks, price lists and the catalog
# image ZIPs land here before being copied into data/suppliers/*/source/.
# Same licence restriction, and it runs to hundreds of MB of their photography.
Files_Site/
